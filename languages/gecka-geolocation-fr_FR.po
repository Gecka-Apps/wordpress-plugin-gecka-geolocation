#. Plugin Name of the plugin
#: bootstrap.php
#: inc/core/Admin/SettingsPage.php:139
#: inc/core/Admin/SiteHealth.php:267
msgid "Gecka Geolocation"
msgstr "Gecka Geolocation"

#. Plugin URI of the plugin
#: bootstrap.php
msgid "https://github.com/Gecka-Apps/wordpress-plugin-gecka-geolocation"
msgstr "https://github.com/Gecka-Apps/wordpress-plugin-gecka-geolocation"

#. Description of the plugin
#: bootstrap.php
msgid "Downloads the IP geolocation databases of MaxMind (GeoLite or GeoIP®), DB-IP and IPinfo, keeps them up to date, and lets other plugins and WooCommerce locate an IP address on the server."
msgstr "Télécharge les bases de géolocalisation IP de MaxMind (GeoLite ou GeoIP®), DB-IP et IPinfo, les tient à jour, et permet aux autres extensions et à WooCommerce de localiser une adresse IP sur le serveur."

#. Author of the plugin
#: bootstrap.php
msgid "Gecka"
msgstr "Gecka"

#. Author URI of the plugin
#: bootstrap.php
msgid "https://gecka.nc"
msgstr "https://gecka.nc"

